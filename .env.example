# Compose 项目名（容器、网络、卷的前缀）
COMPOSE_PROJECT_NAME=tripmatch

# MySQL 初始化（仅首次启动生效）
MYSQL_ROOT_PASSWORD=root_pass_change_me
MYSQL_DATABASE=tripmatch
MYSQL_USER=tripmatch
MYSQL_PASSWORD=tripmatch_pass

# 后端连接数据库
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=tripmatch
DATABASE_USER=tripmatch
DATABASE_PASSWORD=tripmatch_pass

# JWT 签名密钥（生产环境务必修改）
JWT_SECRET=dev_secret_change_me

# 高德地图 JS API Key（可选）
AMAP_KEY=
