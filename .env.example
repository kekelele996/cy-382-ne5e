# Docker Compose 项目名（容器名统一 tripmatch- 前缀）
COMPOSE_PROJECT_NAME=tripmatch

# MySQL 数据库配置
MYSQL_ROOT_PASSWORD=tripmatch_root_pass
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=tripmatch
DATABASE_USER=tripmatch
DATABASE_PASSWORD=tripmatch_pass

# JWT 签名密钥（生产环境请务必修改为随机长字符串）
JWT_SECRET=please_change_me_to_a_long_random_secret

# 高德地图 JS API Key（前端地图展示用，可留空）
AMAP_KEY=
